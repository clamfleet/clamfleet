#
# Copy to local.mk (gitignored; the Makefile includes it). Values come from the
# environment first (?=). Also copy deploy/test/local.env.example for the scripts.
#
# CFT_EXEC: command prefix that runs a command inside the test container. Its
# arguments must contain no spaces or shell syntax (ssh re-parses them).
CFT_EXEC ?= ssh <incus-host> sudo incus exec <container> --
# INCUS_HOST: ssh target of the host that runs Incus.
INCUS_HOST ?= <incus-host>
#
# The AppArmor VM (make e2e-apparmor, docs/testing.md "The AppArmor VM").
# CFA_EXEC: command prefix that runs a command inside the VM (same rule about arguments).
CFA_EXEC ?= ssh <incus-host> sudo incus exec <vm> --
# CFA_HOST: ssh target of the Incus host that holds the VM (its `clean` snapshot is restored before each scenario).
CFA_HOST ?= <incus-host>
#
# The AlmaLinux 9 VM (make e2e-el9, docs/testing.md "The AlmaLinux 9 VM").
# CFE_EXEC: command prefix that runs a command inside the VM (same rule about arguments).
CFE_EXEC ?= ssh <incus-host> sudo incus exec <el9-vm> --
# CFE_HOST: ssh target of the Incus host that holds the VM (its `clean` snapshot is restored before each scenario).
CFE_HOST ?= <incus-host>
