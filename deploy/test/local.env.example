#
# Copy to deploy/test/local.env (gitignored). The deploy/test/*.sh scripts
# source it; a value already in the environment wins (the ":-" form).
CFT_EXEC="${CFT_EXEC:-ssh <incus-host> sudo incus exec <container> --}"
INCUS_HOST="${INCUS_HOST:-<incus-host>}"
# The AppArmor VM (make e2e-apparmor): the same two settings for the VM. The Makefile passes them
# to the suite as CFT_EXEC and INCUS_HOST; the scripts also read them when run by hand.
CFA_EXEC="${CFA_EXEC:-ssh <incus-host> sudo incus exec <vm> --}"
CFA_HOST="${CFA_HOST:-<incus-host>}"
