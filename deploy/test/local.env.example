# Copy to deploy/test/local.env (gitignored). The deploy/test/*.sh scripts
# source it; a value already in the environment wins (the ":-" form).
CFT_EXEC="${CFT_EXEC:-ssh <incus-host> sudo incus exec <container> --}"
INCUS_HOST="${INCUS_HOST:-<incus-host>}"
