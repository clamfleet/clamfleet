[Unit]
Description=Replay the recorded freshclam run into the journal (CI image)
After=systemd-journald.service
Requires=systemd-journald.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/replay-freshclam-history.sh

[Install]
WantedBy=multi-user.target
