#
# Daily database backup. Ships DISABLED: enable it with
# `systemctl enable --now clamfleet-server-backup.timer`.
[Unit]
Description=ClamFleet server database backup (daily)

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
