#
# The ClamFleet server. The default configuration listens on 127.0.0.1:8443 in
# plaintext (behind a reverse proxy that terminates TLS), so it starts with no TLS
# files. `systemctl reload` re-reads tls.cert, tls.key and tls.client_ca (SIGHUP).
#
# StateDirectory creates /var/lib/clamfleet-server 0700 for the server user: the
# database and the backups live there, and ProtectSystem=strict makes it the only
# writable place. A backup.dir elsewhere needs a drop-in with ReadWritePaths=.
# The secret key file and TLS files are read-only inputs under /etc/clamfleet.
[Unit]
Description=ClamFleet server
Documentation=https://github.com/clamfleet/clamfleet
After=network.target

[Service]
Type=simple
User=clamfleet-server
ExecStart=/usr/bin/clamfleet-server serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StateDirectory=clamfleet-server
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
